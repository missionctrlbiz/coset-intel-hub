NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI providers (all OpenAI-compatible; keys registered under COSET email) ──
# Primary generation (chat, extraction, metadata, vision OCR) — Agnes
AI_API_KEY=
AI_BASE_URL=https://apihub.agnes-ai.com/v1
AI_FAST_MODEL=agnes-2.0-flash
AI_STANDARD_MODEL=agnes-2.0-flash

# HTML beautify (report reflow) — Poolside; omit the key to fall back to Agnes
AI_HTML_API_KEY=
AI_HTML_BASE_URL=https://inference.poolside.ai/v1
AI_HTML_MODEL=poolside/laguna-s-2.1

# Embeddings (semantic search + RAG chat) — Jina AI (jina-embeddings-v3, 1024-dim).
# The dimension must match the latest supabase migration (1024).
JINA_API_KEY=
AI_EMBEDDINGS_BASE_URL=https://api.jina.ai/v1
AI_EMBEDDINGS_MODEL=jina-embeddings-v3
AI_EMBEDDINGS_DIM=1024
